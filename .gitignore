# Android — track the source (manifest, MainActivity, gradle, res) so platform
# work persists, but ignore the synced web bundle (regenerated by cap:sync, like
# www/) and Capacitor-generated config. Build outputs are ignored by
# android/.gitignore (build/, .gradle/, local.properties, *.apk/*.aab).
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/capacitor.settings.gradle
android/app/capacitor.build.gradle

# v1.5: generated OTA manifest (regenerated by build-data.py, uploaded to CDN by
# the publish step). content-meta.js (bundled version marker) IS tracked.
js/content.json

# ASC build/signing scripts with hardcoded account identifiers (public repo — keep local only)
assets/wip/mq_build.sh
assets/wip/mq_submit.py
assets/wip/asc_query.py
assets/wip/ExportOptions-manual.plist
*.p8

# Local Netlify folder
.netlify

# Cloudflare wrangler local state
.wrangler/

# Worker build state
workers/**/.wrangler/

# Local IG posting key (Worker POST_KEY) — never commit
.mq-ig-post-key

# Anthropic API key for scripts/gen-narration.py — never commit
.mq-anthropic-key
